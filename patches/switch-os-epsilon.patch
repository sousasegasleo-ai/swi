+// Blend an A8 mask into the band, centered on (cx, cy).
+void blendMask(BandContext* ctx, const uint8_t* mask, int size, int cx, int cy,
+               KDColor color, int opacity = 256) {
+  int x0 = cx - size / 2;
+  int y0 = cy - size / 2;
+  int jStart = ctx->top() - y0;
+  if (jStart < 0) jStart = 0;
+  int jEnd = ctx->bottom() - y0 + 1;
+  if (jEnd > size) jEnd = size;
+  for (int j = jStart; j < jEnd; j++) {
+    KDColor* r = ctx->row(y0 + j);
+    const uint8_t* m = mask + j * size;
+    for (int i = 0; i < size; i++) {
+      int x = x0 + i;
+      if (x < 0 || x >= k_width || m[i] == 0) {
+        continue;
+      }
+      r[x] = KDColor::Blend(color, r[x], (m[i] * opacity) >> 8);
+    }
+  }
 }
 
