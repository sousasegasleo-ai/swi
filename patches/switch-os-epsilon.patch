+  moving = approach(&m_buttonScroll, buttonScrollTarget()) || moving;
+  moving = approach(&m_focus, m_row == Row::Apps ? 1.f : 0.f) || moving;
+  bool intro = Ion::Timing::millis() - m_introStart < k_introDuration + 40;
+  if (moving || intro) {
+    m_view.reload();
+    return true;
+  }
+  // Pulse of the selection frame / ring
