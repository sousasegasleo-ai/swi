+
+bool Controller::handleEvent(Ion::Events::Event event) {
+  if (m_locked) {
+    if (event == Ion::Events::OK || event == Ion::Events::EXE) {
+      m_locked = false;
+      m_introStart = Ion::Timing::millis();
+      m_view.reload();
+      return true;
+    }
+    // Swallow the other keys, but leave On/Off and system events alone
+    return event.isKeyboardEvent() && event != Ion::Events::OnOff;
+  }
+  if (event == Ion::Events::OK || event == Ion::Events::EXE) {
+    switchToSelectedApp();
+    return true;
+  }
+  if (event == Ion::Events::Left) {
+    move(-1);
+    return true;
+  }
+  if (event == Ion::Events::Right) {
+    move(1);
+    return true;
+  }
+  if (event == Ion::Events::Up) {
+    setRow(Row::Games);
+    return true;
+  }
+  if (event == Ion::Events::Down) {
+    setRow(Row::Apps);
+    return true;
+  }
+  if (event == Ion::Events::Home || event == Ion::Events::Back) {
+    return true;
+  }
+  return false;
+}
+
+void Controller::handleResponderChainEvent(ResponderChainEvent event) {
+  if (event.type == ResponderChainEventType::HasBecomeFirst) {
+    buildMenu();
+    if (!s_lockScreenShown) {
+      // HOME Menu / Continue screen, once at boot like the Switch
+      s_lockScreenShown = true;
+      m_locked = true;
+    }
+    snapAnimations();
+    m_introStart = Ion::Timing::millis();
+    m_view.reload();
+  } else {
+    ViewController::handleResponderChainEvent(event);
   }
