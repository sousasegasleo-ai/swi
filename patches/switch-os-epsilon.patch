+#!/usr/bin/env python3
+"""Generate the Switch-style alpha masks for the Switch-OS home screen.
+
+App glyphs are shared with PSP-OS (../psp/gen_icons.py) and rendered at two
+sizes (button / selected button). The Switch UI shapes (round buttons,
+selection ring, HOME house, A button, console, avatars) are drawn here.
+All masks are 8-bit alpha (A8), antialiased with 8x supersampling.
+
+Usage: gen_icons.py <output_header.h> [--preview preview.png]
+"""
+
+import importlib.util
+import math
+import sys
+from pathlib import Path
+
+from PIL import Image, ImageChops, ImageFilter
+
+HERE = Path(__file__).resolve().parent
+spec = importlib.util.spec_from_file_location("psp_icons", HERE.parent / "psp" / "gen_icons.py")
+psp = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(psp)
+Canvas = psp.Canvas
+
+GLYPH, GLYPH_BIG = 17, 21          # app glyph inside a round button
+BUTTON, BUTTON_BIG = 30, 36        # round button diameter
+RING = 44                          # cyan selection ring (outer diameter)
+SHADOW = 40                        # soft shadow under buttons
+
+
+def render(fn, size):
+    c = Canvas()
+    fn(c)
+    return c.img.resize((size, size), Image.LANCZOS)
+
+
+def disc(c):
+    c.circle(50, 50, 50)
+
+
+def ring(c):
+    # 3px ring at 44px -> thickness ~7 design units
+    c.circle(50, 50, 50)
+    c.circle(50, 50, 50 - 7.5, fill=0)
+
+
+def shadow_mask(size):
+    img = Image.new("L", (size, size), 0)
+    inner = render(disc, size - 10)
+    img.paste(inner, (5, 7))
+    return img.filter(ImageFilter.GaussianBlur(2.5)).point(lambda v: int(v * 0.35))
+
+
+def house(c):
+    # HOME icon of the lock screen: white circle outline with a house
+    c.circle(50, 50, 48, fill=None, outline=255, width=6)
+    c.poly([(50, 24), (78, 48), (71, 48), (71, 74), (29, 74), (29, 48), (22, 48)])
+    c.rect(44, 56, 56, 74, fill=0)
+
+
+def a_button(c):
+    c.circle(50, 50, 50)
+    c.text(50, 52, "A", 62, fill=0)
+
+
+def console(c):
+    # Handheld Switch: two joy-cons and the screen
+    c.rrect(4, 22, 96, 78, 12)
+    c.rrect(22, 30, 78, 70, 3, fill=0)
+    c.rect(18, 22, 20, 78, fill=0)
+    c.rect(80, 22, 82, 78, fill=0)
+    c.circle(11, 40, 3.5, fill=0)
+    c.circle(89, 60, 3.5, fill=0)
+
+
+def avatar(c):
+    # Simple player silhouette, drawn in white on a coloured disc
+    c.circle(50, 38, 16)
+    c.ellipse(22, 60, 78, 104)
+
+
+def wifi(c):
+    for r in (44, 30):
+        c.arc(50 - r, 80 - r, 50 + r, 80 + r, 225, 315, 9)
+    c.circle(50, 76, 7)
+
+
+SHAPES = [
+    ("button", disc, BUTTON),
+    ("button_big", disc, BUTTON_BIG),
+    ("ring", ring, RING),
+    ("house", house, 46),
+    ("a_button", a_button, 14),
+    ("a_button_big", a_button, 20),
+    ("console", console, 22),
+    ("avatar", avatar, 14),
+    ("avatar_disc", disc, 21),
+]
+
+
+def c_array(name, img):
+    data = list(img.tobytes())
+    lines = ["  " + ", ".join(str(v) for v in data[i:i + 24]) + ","
+             for i in range(0, len(data), 24)]
+    return f"constexpr uint8_t {name}[{len(data)}] = {{\n" + "\n".join(lines) + "\n};\n"
+
+
+def main():
+    out = sys.argv[1]
+    preview = sys.argv[3] if len(sys.argv) > 3 and sys.argv[2] == "--preview" else None
+    parts = ["// Generated by apps/home/switch/gen_icons.py - do not edit\n#pragma once\n"
+             "#include <stdint.h>\n\nnamespace Home {\nnamespace SwitchIcons {\n\n",
+             f"constexpr int k_glyphSize = {GLYPH};\nconstexpr int k_glyphBigSize = {GLYPH_BIG};\n",
+             f"constexpr int k_shadowSize = {SHADOW};\n\n"]
+    previews = []
+    for name, fn, size in SHAPES:
+        img = render(fn, size)
+        parts.append(f"constexpr int k_{name}Size = {size};\n")
+        parts.append(c_array(f"k_{name}", img))
+        previews.append(img)
+    sh = shadow_mask(SHADOW)
+    parts.append(c_array("k_shadow", sh))
+    previews.append(sh)
+    for name, fn in psp.ITEMS:
+        small = render(fn, GLYPH)
+        big = render(fn, GLYPH_BIG)
+        parts.append(c_array(name + "_glyph", small))
+        parts.append(c_array(name + "_glyph_big", big))
+        previews += [small, big]
+    parts.append("constexpr const uint8_t* k_glyph[] = {" +
+                 ", ".join(n + "_glyph" for n, _ in psp.ITEMS) + "};\n")
+    parts.append("constexpr const uint8_t* k_glyphBig[] = {" +
+                 ", ".join(n + "_glyph_big" for n, _ in psp.ITEMS) + "};\n")
+    parts.append("\n}  // namespace SwitchIcons\n}  // namespace Home\n")
+    Path(out).write_text("".join(parts))
+
+    if preview:
