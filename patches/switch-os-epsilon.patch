+#!/usr/bin/env python3
+"""Generate the PSP-style (XMB) white glyph icons for the PSP-OS home screen.
+
+Every icon is drawn as vector shapes in a 100x100 design space, rendered with
+8x supersampling, then exported as 8-bit alpha masks (A8) in a C++ header.
+For each icon two masks are produced:
+  - a "small" mask (unselected state)
+  - a "big" mask with a soft glow halo baked in (selected state)
+
+Usage: gen_icons.py <output_header.h> [--preview preview.png]
+"""
+
+import math
+import sys
+
+from PIL import Image, ImageChops, ImageDraw, ImageFilter, ImageFont
+
+SS = 8  # supersampling factor
+D = 100  # design space size
+
+FONT_PATHS = [
+    "/System/Library/Fonts/Helvetica.ttc",
+    "/System/Library/Fonts/Supplemental/Arial Bold.ttf",
+    "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
+]
+
+
+def font(size):
+    for p in FONT_PATHS:
+        try:
+            return ImageFont.truetype(p, size, index=1) if p.endswith(".ttc") else ImageFont.truetype(p, size)
+        except Exception:
+            continue
+    return ImageFont.load_default()
+
+
+class Canvas:
+    """Draw in 100x100 design units on a supersampled L image."""
+
+    def __init__(self):
+        self.n = D * SS
+        self.img = Image.new("L", (self.n, self.n), 0)
+        self.d = ImageDraw.Draw(self.img)
+
+    def s(self, v):
+        return v * SS
+
+    def box(self, x0, y0, x1, y1):
+        return [self.s(x0), self.s(y0), self.s(x1), self.s(y1)]
+
+    def rrect(self, x0, y0, x1, y1, r, fill=255, outline=None, width=0):
+        self.d.rounded_rectangle(self.box(x0, y0, x1, y1), radius=self.s(r), fill=fill,
+                                 outline=outline, width=int(round(self.s(width))) if width else 0)
+
+    def rect(self, x0, y0, x1, y1, fill=255):
+        self.d.rectangle(self.box(x0, y0, x1, y1), fill=fill)
+
+    def ellipse(self, x0, y0, x1, y1, fill=255, outline=None, width=0):
+        self.d.ellipse(self.box(x0, y0, x1, y1), fill=fill, outline=outline,
+                       width=int(round(self.s(width))) if width else 0)
+
+    def circle(self, cx, cy, r, fill=255, outline=None, width=0):
+        self.ellipse(cx - r, cy - r, cx + r, cy + r, fill=fill, outline=outline, width=width)
+
+    def line(self, pts, width, fill=255, joint="curve"):
+        self.d.line([(self.s(x), self.s(y)) for x, y in pts], fill=fill, width=int(round(self.s(width))), joint=joint)
+        # round caps
+        for x, y in (pts[0], pts[-1]):
+            self.circle(x, y, width / 2, fill=fill)
+
+    def poly(self, pts, fill=255):
+        self.d.polygon([(self.s(x), self.s(y)) for x, y in pts], fill=fill)
+
+    def text(self, cx, cy, txt, size, fill=255):
+        f = font(self.s(size))
+        bb = self.d.textbbox((0, 0), txt, font=f)
+        w, h = bb[2] - bb[0], bb[3] - bb[1]
+        self.d.text((self.s(cx) - w / 2 - bb[0], self.s(cy) - h / 2 - bb[1]), txt, font=f, fill=fill)
+
+    def arc(self, x0, y0, x1, y1, start, end, width, fill=255):
+        self.d.arc(self.box(x0, y0, x1, y1), start, end, fill=fill, width=int(round(self.s(width))))
+
+    def paste_rotated(self, other, angle):
+        rot = other.img.rotate(angle, resample=Image.BICUBIC, center=(self.n / 2, self.n / 2))
+        self.img = ImageChops.lighter(self.img, rot)
+        self.d = ImageDraw.Draw(self.img)
+
+
+# ---------------------------------------------------------------- categories
+
+def cat_settings(c):
+    # Toolbox (PSP "Settings")
+    c.arc(34, 14, 66, 44, 180, 360, 7)
+    c.rect(34, 28, 41, 36)
+    c.rect(59, 28, 66, 36)
+    c.rrect(8, 32, 92, 88, 7)
+    c.rect(8, 52, 92, 56, fill=0)  # lid separation
+    c.rrect(43, 46, 57, 62, 3, fill=0)  # latch hole
+    c.rrect(46, 49, 54, 59, 2)  # latch
+
+
+def cat_calc(c):
+    # Calculator
+    c.rrect(20, 6, 80, 94, 9)
+    c.rrect(28, 14, 72, 34, 3, fill=0)
+    for row in range(4):
+        for col in range(3):
+            x = 29 + col * 15
+            y = 42 + row * 12.5
+            c.rrect(x, y, x + 12, y + 9, 2.5, fill=0)
+
+
+def cat_graph(c):
+    # Axes and a curve
+    c.line([(14, 8), (14, 86), (94, 86)], 7, joint="curve")
+    pts = []
+    for i in range(41):
+        x = 22 + i * 1.75
+        y = 52 - 30 * math.sin((x - 22) / 70 * 2 * math.pi)
+        pts.append((x, y))
+    c.line(pts, 7)
+
+
+def cat_stats(c):
+    # Bar chart
+    heights = [36, 62, 48, 80]
+    for i, h in enumerate(heights):
+        x = 10 + i * 21
+        c.rrect(x, 88 - h, x + 16, 88, 2.5)
+    c.rect(4, 90, 96, 95)
+
+
+def cat_extra(c):
+    # Atom
+    c.circle(50, 50, 9)
+    ring = Canvas()
+    ring.ellipse(8, 34, 92, 66, fill=None, outline=255, width=6)
+    for a in (0, 60, 120):
+        c.paste_rotated(ring, a)
+
+
+def cat_games(c):
+    # Game controller (PSP "Game")
+    c.rrect(12, 28, 88, 62, 17)
+    c.ellipse(4, 34, 40, 84)
+    c.ellipse(60, 34, 96, 84)
+    # d-pad
+    c.rect(18, 46, 36, 52, fill=0)
+    c.rect(24, 40, 30, 58, fill=0)
+    # buttons
+    c.circle(72, 41, 4.5, fill=0)
+    c.circle(72, 57, 4.5, fill=0)
+    c.circle(64, 49, 4.5, fill=0)
+    c.circle(80, 49, 4.5, fill=0)
+
+
+# --------------------------------------------------------------------- items
+
+def it_calculation(c):
+    c.rrect(8, 8, 92, 92, 14, fill=None, outline=255, width=6)
+    c.rect(48, 14, 52, 86)
+    c.rect(14, 48, 86, 52)
+    # + top-left
+    c.rect(22, 29, 40, 33)
+    c.rect(29, 22, 33, 40)
+    # - top-right
+    c.rect(60, 29, 78, 33)
+    # x bottom-left
+    c.line([(23, 61), (39, 77)], 4.5)
+    c.line([(39, 61), (23, 77)], 4.5)
+    # = bottom-right
+    c.rect(60, 63, 78, 67)
+    c.rect(60, 71, 78, 75)
+
+
+def it_solver(c):
+    c.text(32, 50, "x", 62)
+    c.rect(58, 38, 92, 45)
+    c.rect(58, 55, 92, 62)
+
+
+def it_finance(c):
+    c.circle(50, 50, 42, fill=None, outline=255, width=7)
+    c.text(51, 51, "€", 52)
+
+
+def it_graph(c):
+    c.line([(12, 8), (12, 88), (92, 88)], 6)
+    pts = [(20 + i * 1.8, 80 - 0.0105 * ((20 + i * 1.8) - 56) ** 2 * -1 - 62 + 0.0) for i in range(0)]
+    pts = []
+    for i in range(36):
+        x = 22 + i * 2
+        y = 18 + ((x - 57) / 35.0) ** 2 * 60
+        pts.append((x, y))
+    c.line(pts, 6)
+
+
+def it_sequence(c):
+    c.line([(10, 8), (10, 90), (94, 90)], 5)
+    for i in range(5):
+        x = 24 + i * 16
+        y = 78 - (i * i) * 3.6
+        c.circle(x, y, 6.5)
+
+
+def it_regression(c):
+    pts = [(20, 74), (30, 62), (40, 66), (52, 50), (62, 46), (72, 30), (82, 28)]
+    for x, y in pts:
+        c.circle(x, y, 5.5)
+    c.line([(10, 84), (92, 20)], 5)
+
+
+def it_statistics(c):
+    heights = [24, 46, 72, 56, 30]
+    for i, h in enumerate(heights):
+        x = 9 + i * 17
+        c.rect(x, 90 - h, x + 15, 90)
+
+
+def bell(c, filled, tails=False):
+    pts = []
+    for i in range(81):
+        x = 6 + i * 1.1
+        u = (x - 50) / 15.0
+        y = 86 - 70 * math.exp(-u * u / 2)
+        pts.append((x, y))
+    if filled:
+        c.poly(pts + [(94, 90), (6, 90)])
+    else:
+        c.line(pts, 6)
+        c.rect(4, 87, 96, 92)
+        if tails:
+            left = [p for p in pts if p[0] <= 26]
+            right = [p for p in pts if p[0] >= 74]
+            c.poly(left + [(26, 90), (6, 90)])
+            c.poly(right + [(94, 90), (74, 90)])
+
+
+def it_distributions(c):
+    bell(c, filled=True)
+
+
+def it_inference(c):
+    bell(c, filled=False, tails=True)
+
+
+def it_elements(c):
+    # periodic table silhouette
+    u = 11.5
+    cells = [(0, 0), (7, 0),
+             (0, 1), (1, 1), (5, 1), (6, 1), (7, 1),
+             (0, 2), (1, 2), (2, 2), (3, 2), (4, 2), (5, 2), (6, 2), (7, 2),
+             (0, 3), (1, 3), (2, 3), (3, 3), (4, 3), (5, 3), (6, 3), (7, 3)]
+    for (x, y) in cells:
+        x0 = 4 + x * u
+        y0 = 24 + y * u
+        c.rrect(x0, y0, x0 + u - 2.5, y0 + u - 2.5, 1.5)
+    for x in range(2, 7):
+        x0 = 4 + x * u
+        c.rrect(x0, 24 + 4.5 * u, x0 + u - 2.5, 24 + 5.5 * u - 2.5, 1.5)
+
+
+def it_code(c):
+    c.rrect(6, 14, 94, 86, 10, fill=None, outline=255, width=6)
+    c.line([(22, 36), (38, 50), (22, 64)], 7)
+    c.rect(46, 62, 76, 68)
+
+
+def it_settings(c):
+    # gear
+    cx, cy = 50, 50
+    teeth = 8
+    for i in range(teeth):
+        a = i * 2 * math.pi / teeth
+        dx, dy = math.cos(a), math.sin(a)
+        px, py = -dy, dx
+        w = 8
+        r0, r1 = 30, 44
+        c.poly([(cx + dx * r0 + px * w, cy + dy * r0 + py * w),
+                (cx + dx * r1 + px * (w - 2), cy + dy * r1 + py * (w - 2)),
+                (cx + dx * r1 - px * (w - 2), cy + dy * r1 - py * (w - 2)),
+                (cx + dx * r0 - px * w, cy + dy * r0 - py * w)])
+    c.circle(cx, cy, 34)
+    c.circle(cx, cy, 14, fill=0)
+
+
+def it_umd(c):
+    # UMD disc in its shell
+    c.rrect(10, 6, 90, 94, 30)
+    c.circle(50, 46, 31, fill=0)
+    c.circle(50, 46, 26)
+    c.circle(50, 46, 8, fill=0)
+    c.arc(30, 26, 70, 66, 200, 250, 3, fill=0)
+    c.rrect(36, 82, 64, 87, 2, fill=0)
+
+
+CATEGORIES = [
+    ("cat_settings", cat_settings),
+    ("cat_calc", cat_calc),
+    ("cat_graph", cat_graph),
+    ("cat_stats", cat_stats),
+    ("cat_extra", cat_extra),
+    ("cat_games", cat_games),
+]
+
+ITEMS = [
+    ("it_calculation", it_calculation),
+    ("it_solver", it_solver),
+    ("it_finance", it_finance),
+    ("it_graph", it_graph),
+    ("it_sequence", it_sequence),
+    ("it_regression", it_regression),
+    ("it_statistics", it_statistics),
+    ("it_distributions", it_distributions),
+    ("it_inference", it_inference),
+    ("it_elements", it_elements),
+    ("it_code", it_code),
+    ("it_settings", it_settings),
+    ("it_umd", it_umd),
+]
+
+CAT_SMALL, CAT_BIG = 26, 34
+ITEM_SMALL, ITEM_BIG = 22, 30
+GLOW = 7  # glow padding around big icons
+
+
+def render(fn, size):
+    c = Canvas()
+    fn(c)
+    return c.img.resize((size, size), Image.LANCZOS)
+
+
+def with_glow(icon, pad):
+    w = icon.width + 2 * pad
+    base = Image.new("L", (w, w), 0)
+    base.paste(icon, (pad, pad))
+    glow = base.filter(ImageFilter.GaussianBlur(pad / 2.2))
+    glow = glow.point(lambda v: min(255, int(v * 0.85)))
+    return ImageChops.lighter(base, glow)
+
+
+def c_array(name, img):
+    data = list(img.tobytes())
+    lines = []
+    for i in range(0, len(data), 24):
+        lines.append("  " + ", ".join(str(v) for v in data[i:i + 24]) + ",")
+    return f"constexpr uint8_t {name}[{len(data)}] = {{\n" + "\n".join(lines) + "\n};\n"
+
+
+def main():
+    out = sys.argv[1]
+    preview = sys.argv[3] if len(sys.argv) > 3 and sys.argv[2] == "--preview" else None
+    parts = [
+        "// Generated by apps/home/psp/gen_icons.py - do not edit\n#pragma once\n#include <stdint.h>\n\nnamespace Home {\nnamespace PSPIcons {\n",
+        f"constexpr int k_catSmallSize = {CAT_SMALL};\nconstexpr int k_catBigSize = {CAT_BIG + 2 * GLOW};\n",
+        f"constexpr int k_itemSmallSize = {ITEM_SMALL};\nconstexpr int k_itemBigSize = {ITEM_BIG + 2 * GLOW};\n",
+        f"constexpr int k_glow = {GLOW};\n\n",
+    ]
+    previews = []
+    for name, fn in CATEGORIES:
+        small = render(fn, CAT_SMALL)
+        big = with_glow(render(fn, CAT_BIG), GLOW)
+        parts.append(c_array(name + "_small", small))
+        parts.append(c_array(name + "_big", big))
+        previews.append((small, big))
+    for name, fn in ITEMS:
+        small = render(fn, ITEM_SMALL)
+        big = with_glow(render(fn, ITEM_BIG), GLOW)
+        parts.append(c_array(name + "_small", small))
+        parts.append(c_array(name + "_big", big))
+        previews.append((small, big))
+
+    def table(prefix, entries, suffix):
+        return f"constexpr const uint8_t* {prefix}{suffix.capitalize()}[] = {{" + ", ".join(
+            n + "_" + suffix for n, _ in entries) + "};\n"
+
+    parts.append(table("k_cat", CATEGORIES, "small"))
+    parts.append(table("k_cat", CATEGORIES, "big"))
+    parts.append(table("k_item", ITEMS, "small"))
+    parts.append(table("k_item", ITEMS, "big"))
+    parts.append("\n}  // namespace PSPIcons\n}  // namespace Home\n")
+    with open(out, "w") as f:
+        f.write("".join(parts))
+
+    if preview:
+        cell = 60
+        sheet = Image.new("RGB", (cell * 2, cell * len(previews)), (40, 90, 180))
+        for i, (s, b) in enumerate(previews):
+            white = Image.new("RGB", s.size, (255, 255, 255))
+            sheet.paste(white, (5, i * cell + 5), s)
+            white = Image.new("RGB", b.size, (255, 255, 255))
+            sheet.paste(white, (cell + 5, i * cell + 5), b)
+        sheet = sheet.resize((sheet.width * 2, sheet.height * 2), Image.NEAREST)
+        sheet.save(preview)
+
+
+if __name__ == "__main__":
+    main()
